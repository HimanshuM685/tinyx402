# ── x402 payments ────────────────────────────────────────────────
# Address that receives USDT for every paid request (required).
PAY_TO_ADDRESS=0xYourReceivingAddress
FACILITATOR_URL=https://whitechain.007575.xyz
X402_NETWORK=eip155:1874
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.whitechain.io
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.whitechain.io
NEXT_PUBLIC_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# Free at https://cloud.reown.com. Needed for WalletConnect (mobile wallets); MetaMask works without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Agent + Research (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Search (optional; falls back to DuckDuckGo HTML) ─────────────
BRAVE_API_KEY=
TAVILY_API_KEY=

# ── Browser ──────────────────────────────────────────────────────
# Remote CDP endpoint (Browserless, Steel, self-hosted). Required on Vercel.
# Unset = launch local Chromium (`pnpm exec playwright-core install chromium`).
BROWSER_WS_ENDPOINT=
CHROMIUM_PATH=
# /api/v1/browser hands out per-session CDP URLs via Browserbase. Unset = 501.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Run history (optional; Postgres / Supabase / Neon) ───────────
DATABASE_URL=

# ── Abuse protection ─────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60
