# ── x402 payments ────────────────────────────────────────────────
# Address that receives payment for every paid request, on every chain (required).
PAY_TO_ADDRESS=0xYourReceivingAddress
# Endpoints are per chain: /api/<slug>/v1/<endpoint>, slugs "whitechain" and "arc". Each path
# quotes only its own asset. Chains are defined in lib/chains.ts.
# Narrow which chains are sold (optional; unset = all of them):
# X402_NETWORKS=eip155:1874,eip155:5042002
# NOTE: X402_NETWORK (singular) is the pre-multi-chain name and is IGNORED. Delete it if set,
# or the server logs a warning on every boot.

# ── Chains (all optional; defaults are in lib/chains.ts and viem) ─
# Facilitators — only for self-hosting a verifier/settler of your own.
# WHITECHAIN_FACILITATOR_URL=https://whitechain.007575.xyz
# ARC_FACILITATOR_URL=https://arc.007575.xyz
#
# RPC / explorer per chain. Set an RPC only if you need a dedicated endpoint; the public ones
# work and need no key. Explorers only change the links the UI renders.
# NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# NEXT_PUBLIC_WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# NEXT_PUBLIC_WHITECHAIN_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
#
# Arc's USDC (0x3600…) is a chain predeploy and deliberately NOT overridable: it must match the
# x402 SDK's asset table or every Arc signature verifies to the wrong address.
#
# NEXT_PUBLIC_RPC_URL / NEXT_PUBLIC_EXPLORER_URL / NEXT_PUBLIC_USDT_ADDRESS (no chain in the
# name) predate multi-chain and still apply to Whitechain, so old deployments keep working.

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── TinyFish (all web capabilities) ──────────────────────────────
# Operator key from https://agent.tinyfish.ai/api-keys. Never sent to clients.
TINYFISH_API_KEY=

# ── Run history (optional; Postgres / Supabase / Neon) ───────────
DATABASE_URL=

# ── Google login + platform wallets (web app only, optional) ─────
# Neon Console → Project → Branch → Auth → Configuration. The x402 API never needs a login.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=          # openssl rand -base64 32
WALLET_ENCRYPTION_KEY=            # openssl rand -base64 32 (losing it = losing every platform wallet)
PLATFORM_WALLET_MAX_PER_PAYMENT=5000000   # 5 USDT/USDC, base units (both assets are 6 decimals)

# ── Abuse protection ─────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60
